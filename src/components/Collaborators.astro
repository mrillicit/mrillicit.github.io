---
/**
 * Credit tile for people who worked on a finding alongside the author.
 *
 * Driven by a research entry's `collaborators` array. With an empty array the
 * component renders nothing at all, so a post with no collaborators does not
 * get a stray heading.
 *
 * A handle is shown as given. Pass whatever the person wants to be called,
 * including a pseudonym, and leave `url` out if they would rather not be
 * linked anywhere.
 */
import type { CollectionEntry } from "astro:content";

type Collaborator = NonNullable<
  CollectionEntry<"research">["data"]["collaborators"]
>[number];

interface Props {
  collaborators: Collaborator[];
  /** Heading above the tiles. */
  title?: string;
}

const { collaborators, title = "Found with" } = Astro.props;

const icons = import.meta.glob<{
  default: (_props: Record<string, unknown>) => unknown;
}>("/src/assets/icons/socials/*.svg");

/** Work out which icon a link wants, so the frontmatter does not have to say. */
function iconFor(person: Collaborator) {
  if (person.icon) return person.icon;
  const url = person.url ?? "";
  if (url.startsWith("mailto:")) return "mail";
  if (/(^|\/\/)(www\.)?(x|twitter)\.com\//.test(url)) return "x";
  if (/github\.com\//.test(url)) return "github";
  if (/linkedin\.com\//.test(url)) return "linkedin";
  return undefined;
}

const people = await Promise.all(
  collaborators.map(async person => {
    const name = iconFor(person);
    const mod = name
      ? await icons[`/src/assets/icons/socials/${name}.svg`]?.()
      : undefined;
    return { ...person, Icon: mod?.default };
  })
);

/** Initials for the avatar block, so a tile without an icon is still a tile. */
const initialsOf = (name: string) =>
  name
    .replace(/^@/, "")
    .split(/[\s_-]+/)
    .map(part => part[0])
    .filter(Boolean)
    .join("")
    .slice(0, 2)
    .toUpperCase();
---

{
  people.length > 0 && (
    <section
      class="border-border mt-12 border-t pt-6"
      aria-labelledby="collaborators"
    >
      <h2
        id="collaborators"
        class="text-muted-foreground font-mono text-xs tracking-wide uppercase"
      >
        {title}
      </h2>

      <ul class="mt-3 grid gap-2.5 sm:grid-cols-2">
        {people.map(person => {
          const Tile = person.url ? "a" : "div";
          return (
            <li>
              <Tile
                {...(person.url
                  ? {
                      href: person.url,
                      rel: "noopener noreferrer",
                      target: "_blank",
                    }
                  : {})}
                class:list={[
                  "border-border flex items-center gap-3 rounded-md border p-3.5 transition-colors",
                  person.url && "hover:border-accent",
                ]}
              >
                <span class="border-border text-muted-foreground flex size-9 shrink-0 items-center justify-center rounded-full border font-mono text-xs">
                  {initialsOf(person.name)}
                </span>

                <span class="min-w-0">
                  <span class="flex items-center gap-1.5 text-sm font-semibold">
                    {person.name}
                    {person.Icon && (
                      <person.Icon class="text-muted-foreground size-3.5 shrink-0 fill-transparent stroke-current stroke-2" />
                    )}
                  </span>
                  <span class="text-muted-foreground block truncate text-xs">
                    {person.role ?? "Collaborator"}
                  </span>
                </span>
              </Tile>
            </li>
          );
        })}
      </ul>
    </section>
  )
}
