---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import ResearchCard from "@/components/ResearchCard.astro";
import LinkButton from "@/components/LinkButton.astro";
import { getSortedResearch } from "@/utils/getSortedResearch";
import { displayName, tagline, intro, avatar } from "@/data/profile";
import config from "@/config";

const { socials, posts: postsConfig } = config;
const locale = Astro.currentLocale ?? config.site.lang;
const homePath = getRelativeLocaleUrl(locale, "");

const entries = await getCollection("research");
const sorted = getSortedResearch(entries);
const featured = sorted.filter(({ data }) => data.featured);
const selected = (featured.length > 0 ? featured : sorted).slice(
  0,
  postsConfig.perIndex
);

const initials = displayName
  .split(" ")
  .map(part => part[0])
  .join("")
  .slice(0, 2)
  .toUpperCase();
---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout my-1"
  >
    <section
      id="hero"
      class="flex flex-col gap-6 pt-10 pb-10 sm:flex-row sm:gap-7"
    >
      {
        avatar ? (
          <img
            src={avatar}
            alt={displayName}
            width="92"
            height="92"
            class="border-border size-23 shrink-0 rounded-full border object-cover"
          />
        ) : (
          <div
            aria-hidden="true"
            class="border-border bg-muted text-muted-foreground flex size-23 shrink-0 items-center justify-center rounded-full border text-xl font-semibold"
          >
            {initials}
          </div>
        )
      }
      <div>
        <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">
          {displayName}
        </h1>
        <p class="mt-3 text-base leading-relaxed">{tagline}</p>
        {
          intro && (
            <p class="text-muted-foreground mt-3 text-sm leading-relaxed">
              {intro}
            </p>
          )
        }
        {
          socials.length > 0 && (
            <div class="mt-4">
              <Socials />
            </div>
          )
        }
      </div>
    </section>

    {
      selected.length > 0 && (
        <section id="selected" class="border-border border-t pt-9">
          <h2 class="text-muted-foreground mb-6 font-mono text-[0.69rem] tracking-[0.15em]">
            SELECTED WORK
          </h2>
          {selected.map(entry => (
            <ResearchCard variant="h3" {...entry} />
          ))}
          <LinkButton href={getRelativeLocaleUrl(locale, "research")}>
            All research
            <IconArrowRight class="inline-block rtl:-rotate-180" />
          </LinkButton>
        </section>
      )
    }
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
